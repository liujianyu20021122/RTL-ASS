{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtl-ass.dev/schemas/verification-gate.schema.json",
  "title": "RTL-ASS Verification Gate",
  "type": "object",
  "required": ["schema_version", "gate_status", "required_kinds", "observed_kinds", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "gate_status": {"const": "pass"},
    "required_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["lint", "compile", "simulation", "waveform", "formal", "equivalence", "synthesis", "sta", "coverage", "mutation"]}
    },
    "observed_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["lint", "compile", "simulation", "waveform", "formal", "equivalence", "synthesis", "sta", "coverage", "mutation"]}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "run-evidence.schema.json"}
    }
  },
  "additionalProperties": false
}
